    label: 'Block density (per km2; city mean = Boeing 2025 intersection density)'
    type: 'number'
    definition: @sql {{ #SOURCE.block_density_per_km2 }};;
  }

  dimension tree_canopy_pct {
    label: 'Tree canopy (%)'
    type: 'number'
    definition: @sql {{ #SOURCE.tree_canopy_pct }};;
  }

  dimension safe_speed_share_pct {
    label: 'Safe speed streets (% at or under 30 km/h)'
    type: 'number'
    definition: @sql {{ #SOURCE.safe_speed_share_pct }};;
  }

  dimension car_free_space_pct {
    label: 'Vehicle-free space (%)'
    type: 'number'
    definition: @sql {{ #SOURCE.car_free_space_pct }};;
  }

  dimension transit_near_pct {
    label: 'Transit nearness (% within 500 m bus / 1 km rail, SDG 11.2.1)'
    type: 'number'
    definition: @sql {{ #SOURCE.transit_near_pct }};;
  }

  dimension walk_index_0_100 {
    label: 'Walk index (0 to 100)'
    type: 'number'
    definition: @sql {{ #SOURCE.walk_index_0_100 }};;
  }

  dimension currency_code {
    label: 'Currency code (ISO 4217)'
    type: 'text'
    definition: @sql {{ #SOURCE.currency_code }};;
  }

  dimension currency_symbol {
    label: 'Currency symbol'
    type: 'text'
    definition: @sql {{ #SOURCE.currency_symbol }};;
  }

  dimension usd_fx_rate {
    label: 'Local units per 1 USD (approx., Oct 2026, synthetic)'
    type: 'number'
    definition: @sql {{ #SOURCE.usd_fx_rate }};;
  }

  dimension price_level_vs_usa {
    label: 'Price level vs USA (synthetic)'
    type: 'number'
    definition: @sql {{ #SOURCE.price_level_vs_usa }};;
  }
}

