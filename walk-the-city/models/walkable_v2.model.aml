// Walkable insights v2 (mostly SYNTHETIC). Built by data/build_walkable_db.py into data/walkable.duckdb.
// Generated from the wk_* tables. Nesting: wk_countries <- wk_cities <- wk_neighbourhoods <- wk_streets.
// REAL columns: see wk_provenance (Althoff, WHO, UN WUP, UN-Habitat, city surveys, Boeing 2025, ERA5). See wk_sources.

Model wk_countries {
  type: 'table'
  label: 'Country (40 real countries; mostly REAL columns, see wk_provenance)'
  data_source_name: 'walkable'
  table_name: 'wk_countries'

  dimension iso3 {
    label: 'ISO3 code'
    type: 'text'
    primary_key: true
    definition: @sql {{ #SOURCE.iso3 }};;
  }

  dimension name {
    label: 'Name'
    type: 'text'
    definition: @sql {{ #SOURCE.name }};;
  }

  dimension local_name {
    label: 'Local name'
    type: 'text'
    definition: @sql {{ #SOURCE.local_name }};;
  }

  dimension region {
    label: 'Region'
    type: 'text'
    definition: @sql {{ #SOURCE.region }};;
  }

  dimension sdg_region {
    label: 'Sdg region'
    type: 'text'
    definition: @sql {{ #SOURCE.sdg_region }};;
  }

  dimension steps_per_day {
    label: 'Steps per day'
    type: 'number'
    definition: @sql {{ #SOURCE.steps_per_day }};;
  }

  dimension steps_is_published {
    label: 'Steps is published'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.steps_is_published }};;
  }

  dimension activity_gini {
    label: 'Activity inequality (Gini) REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.activity_gini }};;
  }

  dimension obesity_pct {
    label: 'Obesity (%, WHO 2022) REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.obesity_pct }};;
  }

  dimension overweight_pct {
    label: 'Overweight (%, WHO 2022) REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.overweight_pct }};;
  }

  dimension urban_share_pct {
    label: 'Urban share (%) REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.urban_share_pct }};;
  }

  dimension road_deaths_per_100k {
    label: 'Road deaths per 100k REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.road_deaths_per_100k }};;
  }

  dimension road_deaths_2021 {
    label: 'Road deaths 2021 REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.road_deaths_2021 }};;
  }

  dimension population {
    label: 'Population 2025 REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.population }};;
  }

  dimension urban_is_real {
    label: 'Urban is real'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.urban_is_real }};;
  }

  dimension road_deaths_is_real {
    label: 'Road deaths is real'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.road_deaths_is_real }};;
  }

  dimension population_is_real {
    label: 'Population is real'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.population_is_real }};;
  }

  dimension n_urban_centres {
    label: 'Urban centres (Boeing 2025)'
    type: 'number'
    definition: @sql {{ #SOURCE.n_urban_centres }};;
  }

  dimension urban_density_per_km2 {
    label: 'People per km2 (urban centres, Boeing 2025) REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.urban_density_per_km2 }};;
  }

  dimension intersection_density_per_km2 {
    label: 'Intersections per km2 (Boeing 2025) REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.intersection_density_per_km2 }};;
  }

  dimension street_km_per_km2 {
    label: 'Street km per km2 (Boeing 2025) REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.street_km_per_km2 }};;
  }

  dimension street_circuity {
    label: 'Street circuity (Boeing 2025) REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.street_circuity }};;
  }

  dimension share_4way_pct {
    label: '4-way intersections (%) REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.share_4way_pct }};;
  }

  dimension share_deadend_pct {
    label: 'Dead ends (%) REAL'
    type: 'number'
    definition: @sql {{ #SOURCE.share_deadend_pct }};;
  }

  dimension n_cities {
    label: 'N cities'
    type: 'number'
    definition: @sql {{ #SOURCE.n_cities }};;
  }

  dimension is_default {
    label: 'Is default'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.is_default }};;
  }

  dimension gini_is_published {
    label: 'Gini is published'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.gini_is_published }};;
  }

  dimension obesity_is_real {
    label: 'Obesity is real'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.obesity_is_real }};;
  }

  dimension people_near_services_pct {
    label: 'People near services (%)'
    type: 'number'
    definition: @sql {{ #SOURCE.people_near_services_pct }};;
  }

