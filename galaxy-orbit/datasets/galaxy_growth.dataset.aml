Dataset galaxy_growth {
  label: 'Mobile App Growth'
  description: 'Clearly synthetic demo AAARRR data, 1 January 2023 through 20 October 2026. App-specific value events define activation and repeat value. Install-day stage rates use one generated install cohort. Daily returning, referring and paying users sum to user-days, not period distinct users. This map is a lifecycle, not a single linked-user funnel. Revenue and mature D7/D28 retention remain governed publisher metrics.'
  data_source_name: 'galaxy_demo'
  models: [demo_fact_growth_daily, demo_dim_dates, demo_dim_apps, demo_dim_squads]
  relationships: [
    relationship(demo_fact_growth_daily.date_key > demo_dim_dates.date_key, true),
    relationship(demo_fact_growth_daily.app_key > demo_dim_apps.app_key, true),
    relationship(demo_dim_apps.squad_key > demo_dim_squads.squad_key, true),
  ]

  metric awareness {
    label: 'Awareness impressions'
    type: 'number'
    description: 'Daily paid and organic discovery impressions; repeated exposure is included.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.awareness) ;;
    format: '#,###0'
  }

  metric store_visits {
    label: 'Store listing visits'
    type: 'number'
    description: 'Daily listing visits; visits are not distinct people.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.store_visits) ;;
    format: '#,###0'
  }

  metric installs {
    label: 'Installs'
    type: 'number'
    description: 'Generated install population reconciled exactly to paid plus organic Daily Spend installs.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.installs) ;;
    format: '#,###0'
  }

  metric first_opens {
    label: 'First opens'
    type: 'number'
    description: 'New installers from this install-date cohort who open the app on install day.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.first_opens) ;;
    format: '#,###0'
  }

  metric onboarded {
    label: 'Onboarding completed'
    type: 'number'
    description: 'New installers in this install-date cohort completing onboarding on install day.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.onboarded) ;;
    format: '#,###0'
  }

  metric activated {
    label: 'First value reached'
    type: 'number'
    description: 'New installers in this install-date cohort completing the app-specific first value event on install day.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.activated) ;;
    format: '#,###0'
  }

  metric repeat_value {
    label: 'Repeat value user-days'
    type: 'number'
    description: 'Daily distinct existing users completing an app-specific value event. Summed across dates this is user-days, not period unique users or cohort retention.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.repeat_value) ;;
    format: '#,###0'
  }

  metric referrers {
    label: 'Referrer user-days'
    type: 'number'
    description: 'Daily distinct users sending a referral. Summed across dates this is user-days, not period unique users.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.referrers) ;;
    format: '#,###0'
  }

  metric referred_installs {
    label: 'Referred installs'
    type: 'number'
    description: 'Installs attributed to referrals on that date; a subset of total installs, not extra installs.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.referred_installs) ;;
    format: '#,###0'
  }

  metric paying_users {
    label: 'Paying user-days'
    type: 'number'
    description: 'Daily distinct users who make a purchase or subscription payment. Summed across dates this is payer-days, not period distinct paying customers.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.paying_users) ;;
    format: '#,###0'
  }

  metric sessions {
    label: 'Sessions'
    type: 'number'
    description: 'Sessions started on the date. Must equal total_sessions, which is the explicit quality denominator.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.sessions) ;;
    format: '#,###0'
  }

  metric successful_sessions {
    label: 'Successful sessions'
    type: 'number'
    description: 'Sessions completing the app-specific useful outcome; a subset of total sessions.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.successful_sessions) ;;
    format: '#,###0'
  }

  metric crash_free_sessions {
    label: 'Crash-free sessions'
    type: 'number'
    description: 'Sessions without a recorded crash; a subset of total sessions.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.crash_free_sessions) ;;
    format: '#,###0'
  }

  metric total_sessions {
    label: 'Total sessions'
    type: 'number'
    description: 'All sessions started, including sessions ending in a crash.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.total_sessions) ;;
    format: '#,###0'
  }

  metric uninstalls {
    label: 'Uninstall signals'
    type: 'number'
    description: 'Daily synthetic store/device uninstall signals. Not a matched-user churn rate.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.uninstalls) ;;
    format: '#,###0'
  }

  metric reactivated {
    label: 'Reactivated user-days'
    type: 'number'
    description: 'Daily distinct users returning after the app-specific inactivity threshold. Summed across dates this is user-days.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.reactivated) ;;
    format: '#,###0'
  }

  metric search_impressions {
    label: 'Store search impressions'
    type: 'number'
    description: 'Listing impressions from app-store search; subset of awareness impressions.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.search_impressions) ;;
    format: '#,###0'
  }

  metric search_visits {
    label: 'Store search visits'
    type: 'number'
    description: 'Listing visits from app-store search; subset of store listing visits.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.search_visits) ;;
    format: '#,###0'
  }

  metric rating_count {
    label: 'New ratings'
    type: 'number'
    description: 'Number of ratings submitted on that date, not lifetime review count.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.rating_count) ;;
    format: '#,###0'
  }

  metric rating_sum {
    label: 'New rating score total'
    type: 'number'
    description: 'Sum of 1-to-5 star scores for new ratings; divide by rating_count to obtain a weighted mean.'
    definition: @aql demo_fact_growth_daily | sum(demo_fact_growth_daily.rating_sum) ;;
    format: '#,###0'
  }

  metric first_open_rate {
    label: 'First-open rate'
    type: 'number'
    description: 'Share of the generated install-date cohort opening the app on install day. Later first opens are outside this metric.'
    definition: @aql safe_divide(first_opens, installs) ;;
    format: '#,###0.0%'
  }

  metric onboarding_rate {
    label: 'Onboarding completion rate'
    type: 'number'
    description: 'Share of install-day first openers completing onboarding on install day.'
    definition: @aql safe_divide(onboarded, first_opens) ;;
    format: '#,###0.0%'
  }

  metric activation_rate {
    label: 'First-value rate'
    type: 'number'
    description: 'Share of install-day first openers reaching the app-specific useful outcome on install day.'
    definition: @aql safe_divide(activated, first_opens) ;;
    format: '#,###0.0%'
  }

  metric install_activation_rate {
    label: 'Install-to-value rate'
    type: 'number'
    description: 'Share of the generated install-date cohort reaching the app-specific useful outcome on install day.'
    definition: @aql safe_divide(activated, installs) ;;
    format: '#,###0.0%'
  }

  metric listing_install_ratio {
    label: 'Listing visits to installs'
    type: 'number'
    description: 'Install volume divided by listing visit volume. Aggregate volume ratio, not a matched-user conversion rate.'
    definition: @aql safe_divide(installs, store_visits) ;;
    format: '#,###0.0%'
  }

  metric search_visit_rate {
    label: 'Search impression to visit rate'
    type: 'number'
    description: 'Store search listing visits divided by store search impressions. Same reporting dates, repeated visits included.'
    definition: @aql safe_divide(search_visits, search_impressions) ;;
    format: '#,###0.0%'
  }

  metric referral_install_share {
    label: 'Referral share of installs'
    type: 'number'
    description: 'Installs attributed to referral divided by all installs.'
    definition: @aql safe_divide(referred_installs, installs) ;;
    format: '#,###0.0%'
  }

  metric session_success_rate {
    label: 'Successful session rate'
    type: 'number'
    description: 'Sessions completing the useful outcome divided by all sessions. Higher is usually better; compare the same app and event definition.'
    definition: @aql safe_divide(successful_sessions, total_sessions) ;;
    format: '#,###0.0%'
  }

  metric crash_free_rate {
    label: 'Crash-free session rate'
    type: 'number'
    description: 'Sessions without a crash divided by all sessions. Higher is better; this is session-based, not crash-free users.'
    definition: @aql safe_divide(crash_free_sessions, total_sessions) ;;
    format: '#,###0.0%'
  }

  metric average_rating {
    label: 'Average new rating'
    type: 'number'
    description: 'Weighted average 1-to-5 star score of ratings submitted in the selected dates. Not the lifetime store rating.'
    definition: @aql safe_divide(rating_sum, rating_count) ;;
    format: '#,###0.00'
  }

  metric avg_daily_repeat_value {
    label: 'Average daily returning value users'
    type: 'number'
    description: 'Average daily returning users completing the app-specific value event; adds apps per day before averaging. Not WAU or MAU.'
    definition: @aql
      unique(demo_fact_growth_daily.date_key)
      | select(v: demo_fact_growth_daily | sum(demo_fact_growth_daily.repeat_value))
      | avg(v)
    ;;
    format: '#,###0.0'
  }

  metric avg_daily_paying_users {
    label: 'Average daily paying users'
    type: 'number'
    description: 'Average daily distinct payment users; adds apps per day before averaging. Not period unique payers.'
    definition: @aql
      unique(demo_fact_growth_daily.date_key)
      | select(v: demo_fact_growth_daily | sum(demo_fact_growth_daily.paying_users))
      | avg(v)
    ;;
    format: '#,###0.0'
  }

  metric avg_daily_referrers {
    label: 'Average daily referrers'
    type: 'number'
    description: 'Average daily distinct referring users; adds apps per day before averaging. Not period unique referrers.'
    definition: @aql
      unique(demo_fact_growth_daily.date_key)
      | select(v: demo_fact_growth_daily | sum(demo_fact_growth_daily.referrers))
      | avg(v)
    ;;
    format: '#,###0.0'
  }
}
