Model demo_fact_installs {
  type: 'table'
  label: 'Install Records'
  description: 'One generated record per paid or organic install, reconciled with Daily Spend by date, app and campaign. Country, device and attribution are synthetic allocations, not recovered users.'
  data_source_name: 'galaxy_demo'
  table_name: 'fact_installs'

  dimension install_id {
    label: 'Install ID'
    type: 'text'
    primary_key: true
    definition: @sql {{ #SOURCE.install_id }};;
  }
  dimension date_key {
    label: 'Date Key'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.date_key }};;
  }
  dimension app_key {
    label: 'App Key'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.app_key }};;
  }
  dimension campaign_key {
    label: 'Campaign Key'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.campaign_key }};;
  }
  dimension country_key {
    label: 'Country Key'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.country_key }};;
  }
  dimension device_type {
    label: 'Device Type'
    type: 'text'
    definition: @sql {{ #SOURCE.device_type }};;
  }
  dimension attribution_source {
    label: 'Attribution Source'
    type: 'text'
    definition: @sql {{ #SOURCE.attribution_source }};;
  }
  dimension is_organic {
    label: 'Is Organic'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.is_organic }};;
  }
}
